# Build output
dist/
build/
out/
target/
*.pak
!paks/
!paks/*.pak
*.class

# Generated by the build tooling, never committed
*.generated.md

# Jars are supplied at build time and never committed: the framework jar by
# the builder, the Broadcom SDK jar by the operator. Neither may ship here.
lib/*.jar
*.jar

# Local-only files (e.g. environment-specific patterns for ci/airgap_check.py)
*.local

__pycache__/
